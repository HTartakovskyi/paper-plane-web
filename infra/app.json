{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Paper Plane weekly MVP: private S3 and CloudFront, HTTP API, Node24 Lambda connected to existing private RDS; no NAT.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "why": "Seven-day MVP; existing RDS remains outside stack ownership.",
      "must": [
        "No NAT, no public database, no RDS replacement."
      ]
    }
  },
  "Resources": {
    "FunctionSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "API and migration runner share ENIs and private database access.",
          "must": [
            "No internet ingress or NAT."
          ]
        }
      },
      "Properties": {
        "GroupDescription": "Paper Plane functions: only PostgreSQL egress",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "DestinationSecurityGroupId": {
              "Ref": "DatabaseSecurityGroup"
            }
          }
        ]
      }
    },
    "DatabaseIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Add one scoped rule; leave existing database and rules intact.",
          "must": [
            "Source must be the application security group, never a public CIDR."
          ]
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "FunctionSecurityGroup"
        },
        "Description": "Paper Plane experiment functions only"
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Short retention limits experiment log charges.",
          "must": []
        }
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 7
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated runtime role; ENI wildcard is required by Lambda VPC integration.",
          "must": [
            "No global IAM policy changes; function code cannot manage ENIs; no runtime secret read."
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ApiLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateNetworkInterface",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DescribeSubnets",
                    "ec2:DeleteNetworkInterface",
                    "ec2:AssignPrivateIpAddresses",
                    "ec2:UnassignPrivateIpAddresses"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "ec2:CreateNetworkInterface",
                    "ec2:DeleteNetworkInterface",
                    "ec2:AssignPrivateIpAddresses",
                    "ec2:UnassignPrivateIpAddresses"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "ArnEquals": {
                      "lambda:SourceFunctionArn": {
                        "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${AWS::StackName}-api"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Reuse tested Linux ZIP with cached NestJS startup.",
          "must": [
            "Verified database TLS; migrations never run on API startup."
          ]
        }
      },
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "nodejs24.x",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "index.handler",
        "MemorySize": 512,
        "Timeout": 15,
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ApiKey"
          }
        },
        "VpcConfig": {
          "SubnetIds": {
            "Ref": "SubnetIds"
          },
          "SecurityGroupIds": [
            {
              "Ref": "FunctionSecurityGroup"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "DATABASE_URL": {
              "Fn::Sub": "{{resolve:secretsmanager:${DatabaseSecretArn}:SecretString:DATABASE_URL}}"
            },
            "DATABASE_SSL": "verify-full",
            "DATABASE_CA_FILE": "/var/runtime/ca-cert.pem",
            "DATABASE_POOL_MAX": "1",
            "NODE_EXTRA_CA_CERTS": "/var/runtime/ca-cert.pem",
            "API_RATE_LIMIT": "120",
            "NODE_ENV": "production"
          }
        }
      },
      "DependsOn": [
        "DatabaseIngress",
        "ApiLogs"
      ]
    },
    "MigrationLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Short retention limits experiment log charges.",
          "must": []
        }
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-migration"
        },
        "RetentionInDays": 7
      }
    },
    "MigrationRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated runtime role; ENI wildcard is required by Lambda VPC integration.",
          "must": [
            "No global IAM policy changes; function code cannot manage ENIs; no runtime secret read."
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "MigrationLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateNetworkInterface",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DescribeSubnets",
                    "ec2:DeleteNetworkInterface",
                    "ec2:AssignPrivateIpAddresses",
                    "ec2:UnassignPrivateIpAddresses"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "ec2:CreateNetworkInterface",
                    "ec2:DeleteNetworkInterface",
                    "ec2:AssignPrivateIpAddresses",
                    "ec2:UnassignPrivateIpAddresses"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "ArnEquals": {
                      "lambda:SourceFunctionArn": {
                        "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${AWS::StackName}-migration"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "MigrationFunction": {
      "Type": "AWS::Lambda::Function",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Manually invoked migration inspection; no public route or automatic migration.",
          "must": [
            "Verified database TLS; migrations never run on API startup."
          ]
        }
      },
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-migration"
        },
        "Runtime": "nodejs24.x",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "index.handler",
        "MemorySize": 1024,
        "Timeout": 120,
        "Role": {
          "Fn::GetAtt": [
            "MigrationRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "MigrationKey"
          }
        },
        "VpcConfig": {
          "SubnetIds": {
            "Ref": "SubnetIds"
          },
          "SecurityGroupIds": [
            {
              "Ref": "FunctionSecurityGroup"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "DATABASE_URL": {
              "Fn::Sub": "{{resolve:secretsmanager:${DatabaseSecretArn}:SecretString:DATABASE_URL}}"
            },
            "DATABASE_SSL": "verify-full",
            "DATABASE_CA_FILE": "/var/runtime/ca-cert.pem",
            "DATABASE_POOL_MAX": "1",
            "NODE_EXTRA_CA_CERTS": "/var/runtime/ca-cert.pem",
            "API_RATE_LIMIT": "120",
            "NODE_ENV": "production"
          }
        }
      },
      "DependsOn": [
        "DatabaseIngress",
        "MigrationLogs"
      ]
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Low fixed cost and throttling, matching existing payload 2.0 handler.",
          "must": []
        }
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-http"
        },
        "ProtocolType": "HTTP"
      }
    },
    "ApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Forward requests to NestJS unchanged after edge path rewrite.",
          "must": []
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 20000
      }
    },
    "ApiRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Nest handles route validation.",
          "must": []
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "ApiIntegration"
              }
            ]
          ]
        }
      }
    },
    "ApiStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Protect five-concurrency account and small database; throttle is best effort.",
          "must": []
        }
      },
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 5,
          "ThrottlingRateLimit": 2
        }
      }
    },
    "ApiPermission": {
      "Type": "AWS::Lambda::Permission",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Only this API may invoke the public application handler.",
          "must": []
        }
      },
      "Properties": {
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*"
        }
      }
    },
    "WebBucket": {
      "Type": "AWS::S3::Bucket",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Static compiled assets only; no website endpoint or public ACL.",
          "must": [
            "Private HTTPS access only; retain until explicit cleanup approval."
          ]
        }
      },
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Oac": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "CloudFront signs access to private S3.",
          "must": []
        }
      },
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-s3"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "Rewrite": {
      "Type": "AWS::CloudFront::Function",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Preserve same origin API calls; SPA fallback must not mask API errors.",
          "must": []
        }
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-paths"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Strip API prefix and route extensionless SPA paths",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) { var r = event.request; if (r.uri === '/api' || r.uri.indexOf('/api/') === 0) { r.uri = r.uri.substring(4) || '/'; } else if (r.uri.indexOf('.') === -1) { r.uri = '/index.html'; } return r; }"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Single HTTPS hostname avoids CORS, domains and load balancers.",
          "must": [
            "API caching disabled; origin Host is generated by CloudFront; private S3 OAC only."
          ]
        }
      },
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Paper Plane seven-day MVP",
          "DefaultRootObject": "index.html",
          "PriceClass": "PriceClass_100",
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "web",
              "DomainName": {
                "Fn::GetAtt": [
                  "WebBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "Oac"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            },
            {
              "Id": "api",
              "DomainName": {
                "Fn::Sub": "${HttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}"
              },
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ]
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "web",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "Rewrite",
                    "FunctionMetadata.FunctionARN"
                  ]
                }
              }
            ]
          },
          "CacheBehaviors": [
            {
              "PathPattern": "/api/*",
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": "413f160d-6f9a-4c91-8a7c-450c6f680116",
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "Rewrite",
                      "FunctionMetadata.FunctionARN"
                    ]
                  }
                }
              ],
              "Compress": true
            },
            {
              "PathPattern": "/api",
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": "413f160d-6f9a-4c91-8a7c-450c6f680116",
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "Rewrite",
                      "FunctionMetadata.FunctionARN"
                    ]
                  }
                }
              ],
              "Compress": true
            }
          ]
        }
      }
    },
    "WebPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Only this distribution reads web objects.",
          "must": []
        }
      },
      "Properties": {
        "Bucket": {
          "Ref": "WebBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "WebBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${WebBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${WebBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Url": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      },
      "Description": "Public HTTPS URL"
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      },
      "Description": "CloudFront distribution"
    },
    "WebBucket": {
      "Value": {
        "Ref": "WebBucket"
      },
      "Description": "Private static bucket"
    },
    "ApiFunction": {
      "Value": {
        "Ref": "ApiFunction"
      },
      "Description": "API Lambda"
    },
    "MigrationFunction": {
      "Value": {
        "Ref": "MigrationFunction"
      },
      "Description": "Private migration runner"
    },
    "HttpApiId": {
      "Value": {
        "Ref": "HttpApi"
      },
      "Description": "HTTP API ID"
    },
    "FunctionSecurityGroup": {
      "Value": {
        "Ref": "FunctionSecurityGroup"
      },
      "Description": "Function security group"
    }
  },
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "ArtifactBucket": {
      "Type": "String"
    },
    "ApiKey": {
      "Type": "String"
    },
    "MigrationKey": {
      "Type": "String"
    },
    "DatabaseSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:.*"
    }
  }
}
