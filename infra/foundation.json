{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Paper Plane deployment artifacts and database secret; retained separately from disposable web infrastructure.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "why": "Seven-day MVP; existing RDS remains outside stack ownership.",
      "must": [
        "No NAT, no public database, no RDS replacement."
      ]
    }
  },
  "Resources": {
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Immutable Lambda ZIPs; no user or database data.",
          "must": [
            "Private HTTPS access only; retain until explicit cleanup approval."
          ]
        }
      },
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireBuilds",
              "Status": "Enabled",
              "ExpirationInDays": 14,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ArtifactsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Reject plaintext transport.",
          "must": []
        }
      },
      "Properties": {
        "Bucket": {
          "Ref": "Artifacts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Artifacts",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Artifacts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "DatabaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Deploy-time reference avoids runtime Secrets Manager network access.",
          "must": [
            "Never output or commit SecretString."
          ]
        }
      },
      "Properties": {
        "Description": "Paper Plane database URL; populated securely before application stack deployment."
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    }
  },
  "Outputs": {
    "ArtifactBucket": {
      "Value": {
        "Ref": "Artifacts"
      },
      "Description": "Private deployment artifact bucket"
    },
    "DatabaseSecretArn": {
      "Value": {
        "Ref": "DatabaseSecret"
      },
      "Description": "Secret identifier only, never its value"
    }
  }
}
